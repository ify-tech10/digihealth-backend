# Copy this file to .env (same folder) and fill in real values.
# .env is git-ignored - never commit it.

# Supabase > Project > Connect > Session pooler, written as JDBC:
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.<project-ref>
DB_PASSWORD=<database-password>

# Resend: API key with "Sending access". Until you verify a domain, Resend only
# delivers to the email you signed up with, from onboarding@resend.dev.
MAIL_PASSWORD=<resend-api-key>
MAIL_FROM=onboarding@resend.dev
# MAIL_ENABLED=false   # print links in the console instead of sending

# Signs access tokens. Generate in Git Bash:  openssl rand -base64 48
JWT_SECRET=<random-64-characters>
# COOKIE_SECURE=false  # only if your browser refuses the cookie on http://localhost

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# First super admin - created on startup if no admin exists yet
BOOTSTRAP_ADMIN_EMAIL=you@example.com
BOOTSTRAP_ADMIN_NAME=Your Name
